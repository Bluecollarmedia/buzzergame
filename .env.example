# CrowdQuiz environment variables.
# Copy the web values to apps/web/.env.local and the mobile values to
# apps/player-mobile/.env. Never commit real values.

# ---- Website (apps/web) — public values, safe in the browser ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public URL of the website. Used for QR codes, join links and auth emails.
NEXT_PUBLIC_SITE_URL=https://crowdquiz.example.com

# ---- Website: native app link verification (optional, server-only) ----
# Apple Team ID + bundle id, e.g. ABCDE12345.com.crowdquiz.player
IOS_APP_ID=
# Android package name and the SHA-256 fingerprint(s) of your signing key (comma separated)
ANDROID_PACKAGE_NAME=com.crowdquiz.player
ANDROID_SHA256_CERT_FINGERPRINTS=

# ---- Native player app (apps/player-mobile) ----
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SITE_URL=https://crowdquiz.example.com
IOS_BUNDLE_ID=com.crowdquiz.player
EAS_PROJECT_ID=

# ---- NOT for any app ----
# The Supabase service-role key bypasses all security rules. It is never
# used by the website or the app. Only use it from your own machine for the
# one-time admin bootstrap (docs/admin.md) or local test scripts.
