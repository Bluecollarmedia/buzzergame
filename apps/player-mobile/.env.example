# Public values only. Never put a service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Your website. It serves the /j/<token> join links, /privacy, /terms and /support.
EXPO_PUBLIC_SITE_URL=https://your-domain.com
# Shown in the app for support and reports. Must be a real inbox you read.
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
# Build-time identifiers (use your own reverse-domain name)
IOS_BUNDLE_ID=com.buzzavid.app
ANDROID_PACKAGE_NAME=com.buzzavid.app
EAS_PROJECT_ID=
