{
  "name": "crowdquiz",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.9" },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @crowdquiz/shared build && pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @crowdquiz/shared test",
    "test:db": "pnpm --filter @crowdquiz/db-tests test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
